VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local/hosted Social Planner backend. Owner API key is entered at runtime and
# kept in sessionStorage; never put it in a VITE_ variable.
VITE_BACKEND_URL=http://127.0.0.1:3001

# Cloudinary (optional — add for media upload support)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
