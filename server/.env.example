# Server environment variables
# NEVER commit this file. Only .env.example is committed.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Meta / Facebook (server-side only — never expose to frontend)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# Cloudinary (server-side only — never expose to frontend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
