# Server environment variables
# NEVER commit this file. Only .env.example is committed.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Personal owner access for privileged HTTP routes (minimum 32 random characters)
OWNER_API_KEY=

# Safe local defaults. Configure explicit values when deploying the server.
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Meta / Facebook (server-side only — never expose to frontend)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# Threads (server-side only — never expose to frontend)
THREADS_USER_ID=
THREAD_ACCESS_TOKEN=

# Threads and Instagram (server-side only — never expose to frontend)
# Threads publishing uses the Instagram Graph API; same credentials apply
IG_USER_ID=
IG_ACCESS_TOKEN=

# YouTube (server-side only — never expose to frontend)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Cloudinary (server-side only — never expose to frontend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
